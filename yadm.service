[Unit]
Description=Al-Ye'AnDiMo — Display Informasi Masjid
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/yadm
ExecStart=/usr/bin/node /home/pi/yadm/build
Restart=on-failure
RestartSec=5
Environment=PORT=3000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
